{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@POM/*": ["POM/*"],
      "@helpers/*": ["helpers/*"],
      "@interfaces/*": ["interfaces/*"],
      "@tests/*": ["tests/*"],
      "@utils/*": ["utils/*"],
    }
  },
  "include": ["POM", "helpers", "interfaces", "tests"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}